# Copy to `.env` (gitignored) or export as environment variables.
#
#   PowerShell:
#     $env:MODEL_NAME="buffalo_l"; $env:MODEL_ROOT="$HOME\.insightface\models"; $env:ONNX_PROVIDER="auto"
#     uvicorn app.main:app --host 0.0.0.0 --port 8000
#
#   bash / zsh:
#     export MODEL_NAME="buffalo_l" MODEL_ROOT="$HOME/.insightface/models" ONNX_PROVIDER="auto"
#     uvicorn app.main:app --host 0.0.0.0 --port 8000

# --- InsightFace model pack (RetinaFace det_500m + ArcFace w600k_r50) -----
MODEL_NAME=buffalo_l
# Base directory for insightface; the pack is expected at
# <MODEL_ROOT>/models/<MODEL_NAME> (i.e. ~/.insightface/models/buffalo_l).
MODEL_ROOT=~/.insightface

# ONNX Runtime provider: auto | cpu | cuda
ONNX_PROVIDER=auto

# --- Detection (RetinaFace) ----------------------------------------------
DETECTION_THRESHOLD=0.5
# JSON list of [width, height] fed to the detector: [640, 640]
DETECTION_SIZE=[640, 640]
MAX_FACES_PER_FRAME=20

# --- Face quality assessment -----------------------------------------------
# These thresholds drive the GOOD / WARNING / POOR verdicts used by the
# camera-guidance preview and capture filtering. Calibrate on the real
# classroom dataset before trusting them in production.
# Minimum face dimension (px) to be usable for recognition.
MIN_FACE_SIZE=48
# Minimum face height relative to the image height.
MIN_FACE_RATIO=0.03
# Laplacian variance below this is considered blurry.
BLUR_VARIANCE_THRESHOLD=60.0
# Acceptable mean brightness of the face crop (0-255).
BRIGHTNESS_MIN=40.0
BRIGHTNESS_MAX=245.0
# Approximate pose limits in degrees (derived from landmarks).
POSE_YAW_MAX=40.0
POSE_PITCH_MAX=35.0

# --- Recognition (ArcFace) ------------------------------------------------
EMBEDDING_SIZE=512
# Fallback threshold used only when /match omits "threshold"; the Spring Boot
# backend owns the authoritative threshold (app.recognition.threshold).
SIMILARITY_THRESHOLD=0.6
TOP_K_CANDIDATES=5

# --- Request guards ---------------------------------------------------------
MAX_IMAGE_SIZE=2048
MAX_UPLOAD_BYTES=15728640
MAX_FILES_PER_BATCH=10

# --- Warmup -----------------------------------------------------------------
WARMUP_ON_STARTUP=true

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
