# =====================================================================
# Required values for the Spring Boot backend (local development).
# No real secrets should ever be committed - this file is a template.
#
# Copy this file to .env and fill in your values. `mvn spring-boot:run`
# auto-loads attendance-backend/.env via
# `spring.config.import=optional:file:./.env[.properties]`, so no shell
# environment variables need to be set in each terminal.
#
# Precedence: real OS environment variables override values in this file
# (useful for CI / production); when this file is missing the OS variables
# are used as-is.
#
# Keep values on a single line, unquoted, plain KEY=VALUE. Lines starting
# with '#' are comments. The JWT_SECRET must be at least 32 characters
# (HS256 requirement).
# =====================================================================

DB_URL=jdbc:postgresql://YOUR_HOST:5432/neondb?sslmode=require
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
JWT_SECRET=replace-with-a-long-random-string-32-plus-chars
